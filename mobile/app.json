{
  "expo": {
    "name": "CleanConnect+",
    "slug": "cleanconnectplus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B5E20"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cleanconnect.plus",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CleanConnect+ needs your location to show truck proximity and collection schedules.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "CleanConnect+ needs background location to track truck routes."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyB6m4Hn6uJdg4Yuaql3pwtiQl33GgNam3U"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B5E20"
      },
      "package": "com.cleanconnect.plus",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB6m4Hn6uJdg4Yuaql3pwtiQl33GgNam3U"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CleanConnect+ needs your location to track the garbage truck near your area."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1B5E20"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
